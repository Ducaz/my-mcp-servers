{
  "name": "jar_reader_mcp",
  "version": "0.2.0",
  "description": "MCP server for reading source code from third-party JAR files",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "jar_reader_mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jar",
    "source-code",
    "java"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "yauzl": "^3.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/yauzl": "^2.10.3",
    "typescript": "^5.0.0"
  }
}
